(fset 'defmacro (macro (symbol args :rest body)
   `(fset ',symbol (macro ,args ,@body))))

(defmacro defun (symbol args :rest body)
   `(fset ',symbol (lambda ,args ,@body)))

(defmacro defvar (symbol :opt value)
   `(set ',symbol ,value))
  
(defmacro fsetq (symbol value)
   `(fset ',symbol ,value))

(defmacro setq (symbol value)
   `(set ',symbol ,value))
  
(defun square (x)
   (* x x))

(defun cube (x)
   (* x x x))
