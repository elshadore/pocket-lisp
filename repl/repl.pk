(defvar repl-running true)

(defun repl-quit ()
  (setq repl-running nil))

(defun parse-eval-print (string)
  (print (catch 'error
      (var forms (parse-list string))
      (var result nil)
      (while (not (nil? forms))
         (setq result (eval (car forms)))
         (setq forms (cdr forms)))
      result)))

(when (= (cadr args) "-e")
  (setq repl-running nil)
  (parse-eval-print (caddr args)))

(while repl-running
  (write "LISP>> ")
  (var input (read-user-input))
  (if input
      (parse-eval-print input)
    (repl-quit)))

'quit
