## Some example code

(defclass Point ()
     x
     y)

(defun make-point (x y)
    (var result (new 'Point))
    (setq-slot result x x)
    (setq-slot result y y)
    result)

(defun point+ (p1 p2)
    (var x (+ (getq-slot p1 x) (getq-slot p2 x)))
    (var y (+ (getq-slot p1 y) (getq-slot p2 y)))
    (make-point x y))

(set-method 'Point '+ (fget 'point+))

'hello