(defmacro dg-define-route (name :rest properties)
  `(put *dg-locations* (object 'DG-Route ,@properties)))

(defvar *dg-locations* nil)

(dg-define-route starting-town
                 :name "Starting Town"
                 :routes '(metal-city))

(dg-define-route metal-city
                 :name "Metal City"
                 :routes '(starting-town))

(defvar *dg-current-location* 'starting-town)

(defun dg-can-move? (from to)
     (member? (get *dg-locations* from :routes) to))

(defun dg-move (to)
    (when (dg-can-move? *dg-current-location* to)
        (setq *dg-current-location* to)))
