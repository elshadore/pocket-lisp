(defparam *example* nil
    :doc "A dynamically scoped parameter.")

(defclass vec2 ()
    :doc "A vector2 class."
    (x 0 :x)
    (y 0 :y))

(defn vec2 (&optional x y)
   :cons 'vec2
   (new 'vec2 'x (or x 0) 'y (or y 0)))

(let ((a (vec2 0 0)))
    ;; Accessors
    (getf a :x))

(defmethod + ((self vec2) other)
     (vec2
        (+ (slot-value self 'x) (slot-value other 'x))
        (+ (slot-value self 'y) (slot-value other 'y))))

(let* ((a (vec2 10 10))
       (b (vec2 -10 200))
       (c (+ a b))))

(defclass map (entity-system rect)
     :doc ""
     (data nil))
     
(defn map (&keys (width 8) (height 8) (x 0) (y 0) (fill nil))
     :cons 'map
     (let ((data (array :size (* width height) :fill fill)))
          (new 'map :x x
                    :y y
                    :width width
                    :height height
                    'data data)))

(map
    :width 200
    :height 200
    :fill 'wall)

(defmacro swap (lhs rhs)
    :doc "A macro to swap two variables."
    (with-gensyms (a b temp)
        `(let* ((,a ,lhs)
                (,b ,rhs)
                (,temp ,a))
             (setf ,a ,b)
             (setf ,b ,temp))))

(swap (car a) (cdr b))
