## Classic when macro. Executes the body is the condition is not nil (true).
(defmacro when (cond :rest body)
    `(if ,cond (progn ,@body) nil))

## Classic unless macro. Executes the body if the condition is nil.
(defmacro unless (cond :rest body)
    `(if ,cond nil (progn ,@body)))

## The identity function.
(defun identity (x) x)

(defun square (x)
   (* x x))

(defun cube (x)
   (* x x x))

## Textbook implemenation of a recursive fibonacci seq function.
(defun fib (n)
   (if (<= n 1)
       n
       (+ (fib (- n 1)) (fib (- n 2)))))

(defun caar (x)
   (car (car x)))
   
(defun cadr (x)
   (car (cdr x)))
   
(defun cdar (x)
   (cdr (car x)))
   
(defun cddr (x)
   (cdr (cdr x)))

(defun caaar (x)
   (car (car (car x))))
   
(defun caadr (x)
   (car (car (cdr x))))
   
(defun cadar (x)
   (car (cdr (car x))))
   
(defun cdaar (x)
   (cdr (car (car x))))
   
(defun caddr (x)
   (car (cdr (cdr x))))
   
(defun cddar (x)
   (cdr (cdr (car x))))
   
(defun cdadr (x)
   (cdr (car (cdr x))))
   
(defun cdddr (x)
   (cdr (cdr (cdr x))))

(defun not (x)
   (if x nil true))

(defun != (:rest comps)
   (not (apply '= comps)))

(defmacro catch (symbol :rest body)
    `(funcatch ,symbol (lambda () ,@body)))

(defmacro block (symbol :rest body)
    `(funcatch ',symbol (lambda () ,@body)))

(defmacro break (symbol value)
    `(throw ',symbol ,value))

(defmacro assert= (:rest comps)
    `(unless (= ,@comps) (error "assert= failed")))

## Swap the value of two input symbols. Both inputs have to be symbols for this macro to work.
(defmacro swap (lhs rhs)
    (let ((temp (gensym)))
       `(progn
          (var ,temp ,lhs)
          (setq ,lhs ,rhs)
          (setq ,rhs ,temp))))

## Basic for loop syntax for iterating over a list.
(defmacro dolist ((el seq) :rest body)
     (let ((temp (gensym)))
         `(progn
            (let ((,temp ,seq))
                 ((,el nil))
                (while ,temp
                   (setq ,el (car ,temp))
                   (setq ,temp (cdr ,temp)))))))
                   
## nil? -> (not x)
## A shortcut function essentially.
(defun nil? (x)
   (not x))

## We expect a proper list as input. Not nil or a packed list.
(defun last-cons (list)
   (if (nil? (cdr list))
       list
       (last-cons (cdr list))))

## Has nil checking but otherwise expects a proper list.
(defun make-circular-list (list)
   (when list
       (var last (last-cons list))
       (set-cdr last list)
       list))

(defmacro setq-slot (object symbol value)
     `(set-slot ,object ',symbol ,value))
     
(defmacro getq-slot (object symbol)
     `(get-slot ,object ',symbol))

(defun type= (object type)
    (= (typeof object) type))

(defun assoc-key (alist key)
    (car (assoc alist key)))
     
(defun assoc-value (alist key)
    (cdr (assoc alist key)))

(defun read-char (stream)
     (->char (read stream 1 :string)))

(defun read-byte (stream)
     (read stream 1 :byte))

(defun read-until (stream :opt delimiter)
     (var acc (string-array))
     (var cond true)
     (while cond
          (var char (read-char stream))
          (if (and char (!= char delimiter))
              (append acc char)
              (setq cond nil)))
     (->string acc))

(defun read-line (stream)
     (read-until stream ^\newline))

(defun read-all (stream)
     (read-until stream nil))

(defun read-user-input-char ()
     (read-char stdin))

(defun read-user-input ()
     (read-line stdin))

(defun file-close (stream)
    (when (type= stream 'Stream)
        (destroy stream)))

## Open the file FILEPATH and read all its contents
(defun file-slurp (filepath)
    (var file (file-open filepath))
    (var result (read-all file))
    (destroy file)
    result)
     
## Load code in from a file path FILE.
(defun load (filepath)
    (evlist (parse-list (file-slurp file))))

(defun puts (text :opt stream)
    (var stream (or stream stdout))
    (write stream text)
    (flush stream)
    text)