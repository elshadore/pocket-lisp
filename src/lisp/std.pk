(fset 'defmacro (macro (symbol args :rest body)
  `(fset ',symbol (macro ,args ,@body))))

(defmacro defn (symbol args body)
  `(fset ',symbol (lambda ,args ,@body)))

(defmacro defparam (symbol :optional value)
  `(set ',symbol ,value))

(defmacro setq (symbol value)
  `(set ',symbol ,value))

(defmacro getq (symbol)
  `(get ',symbol))

(defmacro fsetq (symbol value)
  `(fset ',symbol ,value))

(defmacro fgetq (symbol)
  `(fget ',symbol ,value))

(defmacro push (location el)
  `(setq ,location (cons ,el ,location)))

(defparam %swap-temp)

(defmacro swap (lhs rhs)
    `(let ((%swap-temp ,lhs))
           (setq ,lhs ,rhs)
           (setq ,rhs ,temp)))

(defmacro block (symbol :rest block)
     `(catch ',symbol ,@block))

(defmacro escape (symbol value)
    `(throw ',symbol ,value))

(defn square (x)
    (* x x))

(defn cube (x)
    (* x x x))

(defn lerp (start end time)
    (+ (* (- end start) time) start))