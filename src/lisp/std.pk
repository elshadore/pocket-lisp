(defmacro when (cond :rest body)
    `(if ,cond (progn ,@body) nil))
    
(defmacro unless (cond :rest body)
    `(if ,cond nil (progn ,@body)))

(defun square (x)
   (* x x))

(defun cube (x)
   (* x x x))

(defun fib (n)
   (if (<= n 1)
       n
       (+ (fib (- n 1)) (fib (- n 2)))))

(defun load (file)
    (evlist (read-list (fs/slurp file))))

(defun caar (x)
   (car (car x)))
   
(defun cadr (x)
   (car (cdr x)))
   
(defun cdar (x)
   (cdr (car x)))
   
(defun cddr (x)
   (cdr (cdr x)))

(defun caaar (x)
   (car (car (car x))))
   
(defun caadr (x)
   (car (car (cdr x))))
   
(defun cadar (x)
   (car (cdr (car x))))
   
(defun cdaar (x)
   (cdr (car (car x))))
   
(defun caddr (x)
   (car (cdr (cdr x))))
   
(defun cddar (x)
   (cdr (cdr (car x))))
   
(defun cdadr (x)
   (cdr (car (cdr x))))
   
(defun cdddr (x)
   (cdr (cdr (cdr x))))

(defun not (x)
   (if x nil true))

(defun != (:rest comps)
   (not (apply '= comps)))

(defmacro catch (symbol :rest body)
    `(funcatch ,symbol (lambda () ,@body)))

(defmacro block (symbol :rest body)
    `(funcatch ',symbol (lambda () ,@body)))

(defmacro break (symbol value)
    `(throw ',symbol ,value))

(defmacro assert= (:rest comps)
    `(unless (= ,@comps) (error "assert= failed")))

(defmacro swap (lhs rhs)
    (let ((temp (gensym)))
       `(progn
          (var ,temp ,lhs)
          (setq ,lhs ,rhs)
          (setq ,rhs ,temp))))

(defmacro dolist ((el seq) :rest body)
     (let ((temp (gensym)))
         `(progn
            (let ((,temp ,seq))
                 ((,el nil))
                (while ,temp
                   (setq ,el (car ,temp))
                   (setq ,temp (cdr ,temp)))))))