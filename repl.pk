(defvar repl/running true)

(defun repl/quit ()
  (setq repl/running nil))

(defun read-eval-print (string)
  (print (catch 'error (eval (read string)))))

(defun test (:opt a b c d)
  (let (((a b :opt c) (list 1 2)))
      (print $"{a}, {b}, {c}, {d}")))

(when (= (cadr args) "-e")
  (setq repl/running nil)
  (read-eval-print (caddr args)))

(while repl/running
  (puts "LISP>> ")
  (var input (fs/read-user-input))
  (if input
      (read-eval-print input)
    (repl/quit)))

'quit
