## Code for the Pocket Lisp REPL

(fset 'square
      (lambda (x)
        (* x x)))

(set 'repl/running t)

(fset 'repl/quit
      (lambda ()
        (set 'repl/running nil)))

(fset 'repl
      (lambda ()
        (while repl/running
          (puts ">> ")
          (print (format (eval (read (read-user-input))))))))

(fset 'fib
      (lambda (n)
        (if (<= n 1)
            n
          (+ (fib (- n 1)) (fib (- n 2))))))


(fset 'last-cons-1
      (lambda (a b)
        (if (nil? b)
            a
          (last-cons-1 (cdr a) (cdr b)))))

(fset 'last-cons
      (lambda (list) (last-cons-1 list (cdr list))))

(fset 'make-circular-list
      (lambda (list)
        (let ((foo (last-cons list)))
          (set-cdr foo list)
          list)))

(fset 'cadr
      (lambda (list)
        (car (cdr list))))

(fset 'cdar
      (lambda (list)
        (cdr (car list))))

(fset 'foopy (lambda (value) "foopy"))

(fset 'test-fun (lambda ()
    `(1 2 ("foo" "wooper" (1 2)) ,@(list 1 2 3 4) 69 420)
    ## `(1 2 ,@(list 3 4) 5 6)
    ))

(fset 'test (lambda ()
      (print (hexdump 'test-fun))))

(if (nil? (cdr argv))
    nil
  (progn
    (print "*~ARG-EVAL~*")
    (print (cadr argv))
    (puts ">> ")
    (print (format (eval (read (cadr argv)))))))

(repl)

(print "REPL Quitting...")