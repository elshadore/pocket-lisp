## Code for the Pocket Lisp REPL

(defvar repl/running t)

(defun repl/quit ()
    (setq repl/running nil))

(defun repl ()
    (while repl/running
        (puts ">> ")
        (catch 'error
          (lambda ()
              (print (format (eval (read (read-user-input)))))))))

    
(if (nil? (cdr argv))
    nil
  (progn
    (print "*~ARG-EVAL~*")
    (print (cadr argv))
    (puts ">> ")
    (print (format (eval (read (cadr argv)))))))

(repl)

(print "REPL Quitting...")