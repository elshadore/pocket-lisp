(defvar repl/running true)

(defvar repl/result nil)

(defun repl/quit ()
  (setq repl/running nil))

(defun read-eval-print (string)
  (setq repl/result (catch 'error (eval (read string))))
  (print repl/result)
  repl/result)

(when (= (cadr args) "-e")
  (setq repl/running nil)
  (read-eval-print (caddr args)))

(while repl/running
  (puts "LISP>> ")
  (var input (fs/read-user-input))
  (if input
      (read-eval-print (input))
    (progn
      (setq repl/result nil)
      (repl/quit))))

repl/result
