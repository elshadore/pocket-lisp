(fset 'square
      (lambda (x)
        (* x x)))

(set 'repl/running t)

(fset 'repl/quit
      (lambda ()
        (set 'repl/running nil)))

(fset 'repl
      (lambda ()
        (while repl/running
          (puts ">> ")
          (print (format (evlist (read (read-user-input))))))))

(set 'foo 69)

(fset 'example
      (lambda ()
        (let ((foo 420))
          (print foo))))

(repl)

(print "REPL Quitting...")

