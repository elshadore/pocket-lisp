## Code for the Pocket Lisp REPL

(defvar repl/running t)

(defmacro when (cond :rest body)
     `(if ,cond (progn ,@body) nil))
          
(defmacro unless (cond :rest body)
     `(if ,cond nil (progn ,@body)))

(defun repl/quit ()
    (setq repl/running nil))

(defvar repl/history nil)

(defun repl ()
    (while repl/running
        (puts ">> ")
        (catch 'error
            (let ((result (eval (read (read-user-input)))))
                 (push repl/history result)
                 (print (format result))))))

(if (nil? (cdr argv))
    nil
  (progn
    (print "*~ARG-EVAL~*")
    (print (cadr argv))
    (puts ">> ")
    (print (format (eval (read (cadr argv)))))))

(repl)

(print "REPL Quitting...")